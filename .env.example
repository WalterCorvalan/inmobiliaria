# Nombres de las variables que usa la app. SIN valores: los valores los carga Walter en Vercel (y en .env.local para probar en su computadora).
# Nunca subir valores reales al repositorio.

# --- Obligatorias ---
# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE2_URL=
NEXT_PUBLIC_SUPABASE2_PUBLISHABLE_KEY=
SUPABASE2_SERVICE_ROLE_KEY=
# Clave para cifrar los tokens de los canales (la inventa Walter, larga y al azar). Si se pierde, hay que volver a pegar todos los tokens.
ENCRYPTION_KEY=
# IA del bot y del resumen (consola de Anthropic). Sin esto el bot no contesta.
ANTHROPIC_API_KEY=
# Clave que protege las tareas automáticas (la inventa Walter). Sin esto las tareas rechazan todo.
CRON_SECRET=

# --- Chat de la web ---
# Identificador público (slug) de la empresa, para el chat que se pega en su sitio.
NEXT_PUBLIC_EMPRESA_SLUG=

# --- Opcionales ---
# Avisos al celular (notificaciones push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Fotos y archivos en Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Respaldo de IA por OpenRouter (si Anthropic falla)
OPENROUTER_API_TOKEN=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
# Meta: versión de la API y ventana de agente humano (solo si hace falta cambiar los valores por defecto)
META_GRAPH_API_VERSION=
META_GRAPH_BASE_URL=
NEXT_PUBLIC_META_HUMAN_AGENT=
# Medición de conversiones de Meta (heredado de Pfaffen; no se usa en la v1)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=

# NO van acá: el secreto de la app de Meta, el ID y secreto de la app de Instagram y los tokens de cada canal.
# Se cargan por empresa, cifrados, desde las pantallas de Configuración de cada canal.
