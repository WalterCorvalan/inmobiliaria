# Variables de entorno de Inmobiliaria CRM. Copiá este archivo como .env.local (en tu compu) o cargalas en Vercel.
# NUNCA subas los valores reales al repositorio. Acá van solo los nombres y de dónde sale cada uno.

# --- Supabase (obligatorias: el servidor no arranca sin las tres) ---
# Supabase > tu proyecto > Project Settings > API
NEXT_PUBLIC_SUPABASE2_URL=
NEXT_PUBLIC_SUPABASE2_PUBLISHABLE_KEY=
# Clave de servicio (secreta: solo en el servidor, nunca en el navegador)
SUPABASE2_SERVICE_ROLE_KEY=

# --- Cifrado de los tokens de Meta de cada empresa (obligatoria para conectar canales) ---
# 32 bytes en base64. Se genera una vez con: openssl rand -base64 32  (si se pierde, hay que volver a cargar los tokens)
ENCRYPTION_KEY=

# --- IA del bot (Anthropic) ---
# console.anthropic.com > API Keys. Poner un límite de gasto en la consola.
ANTHROPIC_API_KEY=
# Opcional: respaldo si Anthropic falla
OPENROUTER_API_TOKEN=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=

# --- Demo pública /demo (opcionales) ---
# Clave aparte para la demo (si no está, usa ANTHROPIC_API_KEY)
DEMO_ANTHROPIC_API_KEY=
# Tope de gasto de la demo por mes, en dólares (por defecto 1.5)
DEMO_TOPE_USD=

# --- Tareas automáticas (Vercel Cron) ---
# Cualquier texto largo al azar: openssl rand -hex 32
CRON_SECRET=

# --- Meta (WhatsApp, Instagram, Messenger) ---
# Las credenciales de cada empresa se cargan en el panel (Configuración), no acá.
META_GRAPH_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Opcionales: medición de conversiones (Conversions API) y píxel
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_HUMAN_AGENT=

# --- Fotos y audios (Cloudflare R2) ---
# Cloudflare > R2 > Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Avisos push en el celular (opcionales) ---
# Se generan con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- Chat de la web sin código para pegar (opcional, una sola empresa) ---
NEXT_PUBLIC_EMPRESA_SLUG=
