{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Queda en https://inmobiliaria.<tu-subdominio>.workers.dev
  "name": "inmobiliaria",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "inmobiliaria" }],
  // Las variables y claves se cargan en el panel de Cloudflare: que el deploy no las borre.
  "keep_vars": true,
  "observability": { "enabled": true }
}
